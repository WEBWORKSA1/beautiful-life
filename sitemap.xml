---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for p in site.pages %}{% if p.url contains ".html" or p.url == "/" %}{% unless p.url == "/404.html" %}<url><loc>{{ site.url }}{{ p.url | replace: "index.html", "" }}</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod><changefreq>{% if p.url == "/" or p.url == "/good-news.html" %}daily{% else %}weekly{% endif %}</changefreq></url>
{% endunless %}{% endif %}{% endfor %}{% for a in site.articles %}<url><loc>{{ site.url }}{{ a.url }}</loc><lastmod>{{ a.date | date: "%Y-%m-%d" }}</lastmod><changefreq>monthly</changefreq></url>
{% endfor %}</urlset>
